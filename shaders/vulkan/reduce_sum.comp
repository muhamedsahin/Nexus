#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer I { float values[]; };
layout(set = 0, binding = 1, std430) writeonly buffer O { float result[]; };
layout(push_constant) uniform P { uint count; } p;
shared float partial[256];
void main() {
  uint tid = gl_LocalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  float sum = 0.0;
  for (uint i = gl_GlobalInvocationID.x; i < p.count; i += stride) sum += values[i];
  partial[tid] = sum;
  barrier();
  for (uint width = 128; width > 0; width >>= 1) {
    if (tid < width) partial[tid] += partial[tid + width];
    barrier();
  }
  if (tid == 0) result[gl_WorkGroupID.x] = partial[0];
}
