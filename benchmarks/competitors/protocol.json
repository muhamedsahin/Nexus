    "c": 32,
    "h": 16,
    "w": 16,
    "k": 3,
    "padding": 1,
    "flop": "2*N*C*H*W*K*K"
  },
  "attention": {
    "batch": 4,
    "time": 32,
    "embed": 64,
    "heads": 4,
    "dropout": 0
  },
  "lstm": {
    "batch": 4,
    "time": 16,
    "input": 32,
    "hidden": 64,
    "output": "sequence"
  },
  "gru": {
    "batch": 4,
    "time": 16,
    "input": 32,
    "hidden": 64,
