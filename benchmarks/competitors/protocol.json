    "gemm": 3,
    "layer": 4
  },
  "threads": ["8", "default"],
  "gemm": {
    "n": [256, 512, 1024, 2048],
    "flop": "2*N*N*N"
  },
  "conv2d": {
    "n": 8,
    "c": 3,
